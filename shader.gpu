// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec2 texCoord;
attribute vec4 tangent;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;
uniform mat3 NormalMatrix;

uniform vec2 TexPivot;
uniform float TexScale;

varying vec3 vNormal;
varying vec3 vPosition;
varying vec2 vTexCoord;
varying mat3 vTBN;

void main() {
    vec4 posView = ModelViewMatrix * vec4(vertex, 1.0);
    vPosition = posView.xyz;

    vec3 N = normalize(NormalMatrix * normal);
    vec3 T = normalize(NormalMatrix * tangent.xyz);

    // Gram-Schmidt orthogonalization, variant: prioritize tangent
    T = normalize(T - N * dot(N, T));
    vec3 B = cross(N, T) * tangent.w;

    vNormal = N;
    vTBN = mat3(T, B, N);
    vTexCoord = fract(TexPivot + (texCoord - TexPivot) * TexScale);
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}`;


// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

uniform vec4 color;
uniform vec3 LightPosition;
uniform sampler2D DiffuseMap;
uniform sampler2D SpecularMap;
uniform sampler2D NormalMap;

varying vec3 vNormal;
varying vec3 vPosition;
varying vec2 vTexCoord;
varying mat3 vTBN;

void main() {
    vec3 nm = texture2D(NormalMap, vTexCoord).xyz * 2.0 - 1.0;
    vec3 N = normalize(vTBN * nm);
    if (!gl_FrontFacing) {
        N = -N;
    }
    vec3 L = normalize(LightPosition - vPosition);
    vec3 V = vec3(0.0, 0.0, 1.0);
    vec3 R = reflect(-L, N);

    float lambert = max(dot(N, L), 0.0);
    float spec = 0.0;
    if (lambert > 0.0) {
        spec = pow(max(dot(R, V), 0.0), 32.0);
    }

    vec3 Ia = vec3(0.12, 0.12, 0.12);
    vec3 Id = vec3(0.85, 0.85, 0.85);
    vec3 Is = vec3(0.8, 0.8, 0.8);

    vec3 base = color.rgb * texture2D(DiffuseMap, vTexCoord).rgb;
    vec3 ks = texture2D(SpecularMap, vTexCoord).rgb;
    vec3 rgb = Ia * base + Id * base * lambert + Is * ks * spec;
    gl_FragColor = vec4(rgb, color.a);
}`;